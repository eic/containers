#!/usr/bin/env bash

piped_args=()
## Piped input is a script to run — unless a command is given, which keeps
## its stdin (an MCP client talks to `eic-mcp run` over that pipe).
if [ $# -eq 0 ] && [ -p /dev/stdin ]; then
  # If we want to read the input line by line
  while IFS= read line; do
    piped_args+=("${line}")
  done
fi

## Properly setup environment
. /etc/eic-env.sh


### Fire off bash
if [ "${#piped_args[@]}" != "0" ]; then
  printf "%s\n" "${piped_args[@]}" | bash -s -- --norc --noprofile
elif [ $# -gt 0 ]; then
  exec bash -c "$@"
else
  exec bash --norc --noprofile
fi
