## Data only: one KEY=value per line, no quotes, no expansion, no trailing
## comments. Parsed by load_vars in scripts/load-vars.sh, never sourced.

## CUDA toolkit version and OS of the nvidia/cuda base images, i.e.
## nvidia/cuda:${CUDA_VERSION}-{devel,runtime}-${CUDA_OS}
##
## Single source of truth: scripts/build-base.sh loads this file to derive
## BASE_IMAGE for cuda_devel and cuda_runtime, in GitHub Actions, GitLab CI and
## local builds alike. Values already set in the environment take precedence
## (load_vars --defaults).
CUDA_VERSION=12.8.2
CUDA_OS=ubuntu24.04
