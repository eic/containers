## Data only: one KEY=value per line, no quotes, no expansion, no trailing
## comments. Parsed by load_vars in scripts/load-vars.sh, never sourced.

## Debian release (codename) of the debian base image, i.e.
## debian:${DEBIAN_VERSION}-slim
##
## Single source of truth: scripts/build-base.sh loads this file to derive
## BASE_IMAGE for debian_stable_base, in GitHub Actions, GitLab CI and local
## builds alike. Values already set in the environment take precedence
## (load_vars --defaults).
DEBIAN_VERSION=trixie
