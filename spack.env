## Data only: one KEY=value per line, no quotes, no expansion, no trailing
## comments. Parsed by load_vars in scripts/load-vars.sh, never sourced.

## Spack organization and repository, e.g. spack/spack
SPACK_ORGREPO=spack/spack

## Spack github version, e.g. v0.18.1 or commit hash
## note: nightly builds will use e.g. releases/v1.0
## Cherry-picks are listed in spack.cherrypicks.
SPACK_VERSION=v1.2.2
